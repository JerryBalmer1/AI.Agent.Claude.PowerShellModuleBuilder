# Build and test output.
output/
testResults/
*.nupkg

# Terraform working state. This module reads configuration as text and never
# runs Terraform, so none of this should ever appear here - these patterns
# exist to make an accident harder rather than to support any supported way of
# producing one.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# Credentials. PSTerraformGraph reads its token from $env:AZDO_PAT and from
# nowhere else, so a credential file in this repository is a mistake by
# definition.
*.pat
**/pat.txt
AzDoPAT.txt
